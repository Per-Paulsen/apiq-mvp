# Production env template for the portfolio deploy.
# Copy values into Vercel project's Environment Variables (Production scope).
# Do NOT commit a filled-in version of this file.

# Database (Supabase production project — EU region)
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Auth.js — generate fresh:  openssl rand -base64 32
AUTH_SECRET="generate-fresh-do-not-reuse-dev"

# OpenRouter (production key, NOT dev key — set $20/24h spend cap on dashboard)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="anthropic/claude-sonnet-4"

# Internal API guard — generate fresh: openssl rand -base64 32
INTERNAL_API_SECRET="generate-fresh-do-not-reuse-dev"

# Cloudflare Turnstile — real production keys, allowed-hostnames includes the
# Vercel deploy domain (e.g. apiq-mvp.vercel.app). Get keys at:
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY="0x4AAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAA..."

# Portfolio-deploy demo mode — activates landing-page demo banner + daily
# /api/cron/reset-demo endpoint. Leave unset (or "false") for non-portfolio
# environments.
DEMO_MODE="true"

# Vercel cron auth — generate fresh: openssl rand -base64 32
# Vercel auto-injects "Authorization: Bearer <CRON_SECRET>" on cron invocations
# when this env var is set in the project.
CRON_SECRET="generate-fresh"

# Optional: override demo seed targets if you captured fixtures with non-default
# names. Defaults to: openweathermap.json, stripe.json
# APIQ_DEMO_FIXTURE_FILES="openweathermap.json,stripe.json"
