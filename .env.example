# Database (Supabase Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth.js (Epic 02)
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# OpenRouter (Epic 04 — v0.1 single-call analysis uses anthropic/claude-sonnet-4 per Epic 00 spike results; future per-endpoint calls may use Haiku)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="anthropic/claude-sonnet-4"

# Internal API guard (Epic 04 /api/internal/analyze route)
INTERNAL_API_SECRET="generate-with-openssl-rand-base64-32"

# Cloudflare Turnstile (Epic 02 anti-enumeration; free tier — get keys at https://dash.cloudflare.com/?to=/:account/turnstile)
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
